# Frozen v22 production options (as used for every GMD v22 run, 29-31 Oct 2026). Source from the repository root.
# The --k path is relative to the repo root: paddy/krxn_calibrated_v22.in (identical to the k_cal.in used in the cloud runs).
export TILL=0.2
export EXE=scepter_paddy_v22
# soil options for the 3-yr drained spin-up (run_flooded_column.py ... --fallow)
export SOIL="--ch4 --n --kaol=0.05 --refsoil --gt=0.02 --exe=$EXE --kscale=maf:0.45,fsp:0.25,amsi:30 --n2c=0.03 --n2oy=6.2:1:0.1 --o2inh=2.5e-7 --nstep=13 --q=0.5 --fe3in=0.3 --fe3=0.012 --om=450 --omalloc=0.2:0.6:0.1"
# season/fallow options for run_chain.sh (later options override earlier ones; Si feedback K_Si 2 mM, w 0.2)
export PROD="--k=paddy/krxn_calibrated_v22.in --phd=14 --pox=0.3:0.9:6:1 --nucl=cc:0.001 --exe=$EXE --kscale=maf:0.45,fsp:0.25,amsi:30 --n2c=0.03 --n2oy=6.2:1:0.1 --o2inh=2.5e-7 --nstep=13 --q=0.5 --fe3in=0.3 --fe3=0.012 --om=450 --omalloc=0.2:0.6:0.1 --rtsi=2e-3:2.7e-4:0.2"
# 0.5 m column with plough pan (25 cells), basal O2 0.21
export P21="--nz=25 --ztot=0.5 --pan=0.2:0.24:0.1:0.8:1:0.1:0.21:-1:0.3"
